{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!public/fonts",
      "!**/*.snap",
      "!**/*.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "security": { "noDangerouslySetInnerHtml": "error" },
      "style": { "noNonNullAssertion": "warn", "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
